rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isActive() {
      return signedIn() && request.auth.token.status == 'active';
    }

    function hasRole(role) {
      return isActive() && request.auth.token.role == role;
    }

    function isSuperAdmin() {
      return hasRole('superAdmin');
    }

    function isBranchViewer() {
      return hasRole('branchViewer');
    }

    function belongsToBranch(branchId) {
      return isActive()
        && request.auth.token.role in ['branchViewer', 'volunteer']
        && request.auth.token.branchId == branchId;
    }

    function isBrazilState(state) {
      return state in ['AC', 'AL', 'AP', 'AM', 'BA', 'CE', 'DF', 'ES', 'GO', 'MA', 'MT', 'MS', 'MG', 'PA', 'PB', 'PR', 'PE', 'PI', 'RJ', 'RN', 'RS', 'RO', 'RR', 'SC', 'SP', 'SE', 'TO'];
    }

    function validBranch(data) {
      return data.keys().hasAll(['name', 'code', 'state', 'status', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['name', 'code', 'state', 'status', 'createdAt', 'updatedAt'])
        && data.name is string
        && data.name.size() >= 2
        && data.name.size() <= 120
        && data.code is string
        && data.code.size() >= 2
        && data.code.size() <= 30
        && data.state is string
        && isBrazilState(data.state)
        && data.status in ['active', 'inactive'];
    }

    function validUser(data) {
      return data.keys().hasAll(['displayName', 'email', 'role', 'branchId', 'status', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['displayName', 'email', 'role', 'branchId', 'contactName', 'contactNameSearch', 'contactEmail', 'contactPhone', 'status', 'createdAt', 'updatedAt'])
        && data.displayName is string
        && data.displayName.size() >= 2
        && data.displayName.size() <= 120
        && data.email is string
        && data.email.size() >= 5
        && data.role in ['superAdmin', 'branchViewer', 'volunteer']
        && data.status in ['pending', 'active', 'blocked']
        && (
          (data.role == 'branchViewer'
            && data.keys().hasAll(['contactName', 'contactNameSearch', 'contactEmail', 'contactPhone'])
            && data.contactName is string
            && data.contactName.size() >= 2
            && data.contactName.size() <= 120
            && data.contactNameSearch is string
            && data.contactNameSearch.size() >= 2
            && data.contactNameSearch.size() <= 120
            && data.contactEmail is string
            && data.contactEmail.size() >= 5
            && data.contactEmail.size() <= 160
            && data.contactPhone is string
            && data.contactPhone.matches('^[0-9]{10,13}$'))
          || (data.role != 'branchViewer' && !data.keys().hasAny(['contactName', 'contactNameSearch', 'contactEmail', 'contactPhone']))
        )
        && (
          (data.role == 'superAdmin' && data.branchId == null)
          || (data.role != 'superAdmin' && data.branchId is string && data.branchId.size() > 0)
        );
    }

    function validVolunteer(data) {
      return data.keys().hasAll(['fullName', 'fullNameSearch', 'email', 'phone', 'actionIds', 'regionalIds', 'participationDates', 'status', 'accessStatus', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['fullName', 'fullNameSearch', 'email', 'phone', 'actionIds', 'regionalIds', 'participationDates', 'status', 'accessStatus', 'createdAt', 'updatedAt'])
        && data.fullName is string
        && data.fullName.size() >= 2
        && data.fullName.size() <= 120
        && data.fullNameSearch is string
        && data.fullNameSearch.size() >= 2
        && data.fullNameSearch.size() <= 120
        && data.email is string
        && data.email.size() <= 160
        && data.phone is string
        && data.phone.size() <= 20
        && data.actionIds is list
        && data.actionIds.size() >= 1
        && data.actionIds.size() <= 20
        && data.regionalIds is list
        && data.regionalIds.size() >= 1
        && data.regionalIds.size() <= 20
        && data.participationDates is list
        && data.participationDates.size() == data.actionIds.size()
        && data.accessStatus in ['none', 'active', 'blocked']
        && data.status in ['pending', 'active', 'blocked'];
    }

    function validVolunteerPrivate(data, volunteerId) {
      return data.keys().hasAll(['volunteerId', 'cpf', 'rg', 'birthDate', 'address', 'shirtSize', 'ngoRelationship', 'lgpdAccepted', 'regulationAccepted', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['volunteerId', 'cpf', 'rg', 'birthDate', 'address', 'shirtSize', 'ngoRelationship', 'lgpdAccepted', 'regulationAccepted', 'createdAt', 'updatedAt'])
        && data.volunteerId == volunteerId
        && data.cpf is string
        && data.cpf.matches('^[0-9]{11}$')
        && data.rg is string
        && data.rg.size() >= 3
        && data.rg.size() <= 20
        && data.birthDate is string
        && data.birthDate.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && data.address.keys().hasAll(['cep', 'street', 'number', 'complement', 'neighborhood', 'city', 'state'])
        && data.address.keys().hasOnly(['cep', 'street', 'number', 'complement', 'neighborhood', 'city', 'state'])
        && data.address.cep is string && data.address.cep.matches('^[0-9]{8}$')
        && data.address.street is string && data.address.street.size() > 0
        && data.address.number is string && data.address.number.size() > 0
        && data.address.complement is string && data.address.neighborhood is string && data.address.neighborhood.size() > 0
        && data.address.city is string && data.address.city.size() > 0
        && data.address.state is string && isBrazilState(data.address.state)
        && data.shirtSize in ['PP', 'P', 'M', 'G', 'GG', 'XG', 'OUTRO']
        && data.ngoRelationship in ['Comunidade ou Projeto local', 'Empregado ou Aposentado da CAIXA', 'Indicação de amigos ou família']
        && data.lgpdAccepted == true && data.regulationAccepted == true;
    }

    function validAction(data) {
      return data.keys().hasAll(['name', 'nameSearch', 'branchId', 'date', 'dateStart', 'dateEnd', 'status', 'address', 'whatToBring', 'tips', 'photosBefore', 'photosDuring', 'photosAfter', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['name', 'nameSearch', 'branchId', 'date', 'dateStart', 'dateEnd', 'startDate', 'endDate', 'startTime', 'endTime', 'scheduleText', 'description', 'status', 'address', 'whatToBring', 'tips', 'photosBefore', 'photosDuring', 'photosAfter', 'createdAt', 'updatedAt'])
        && data.name is string
        && data.name.size() >= 3
        && data.name.size() <= 160
        && data.nameSearch is string
        && data.nameSearch.size() >= 3
        && data.nameSearch.size() <= 160
        && data.branchId is string
        && data.branchId.size() > 0
        && data.date is string
        && data.date.matches('^\\d{4}-\\d{2}-\\d{2}$')
        && data.dateStart is timestamp
        && data.dateEnd is timestamp
        && data.dateStart < data.dateEnd
        && (!data.keys().hasAll(['startDate']) || (data.startDate is string && data.startDate.matches('^\\d{4}-\\d{2}-\\d{2}$')))
        && (!data.keys().hasAll(['endDate']) || (data.endDate is string && data.endDate.matches('^\\d{4}-\\d{2}-\\d{2}$')))
        && (!data.keys().hasAll(['startTime']) || (data.startTime is string && data.startTime.matches('^\\d{2}:\\d{2}$')))
        && (!data.keys().hasAll(['endTime']) || (data.endTime is string && data.endTime.matches('^\\d{2}:\\d{2}$')))
        && (!data.keys().hasAll(['scheduleText']) || (data.scheduleText is string && data.scheduleText.size() <= 500))
        && (!data.keys().hasAll(['description']) || (data.description is string && data.description.size() <= 1500))
        && data.status in ['planning', 'ongoing', 'completed']
        && data.whatToBring is string
        && data.whatToBring.size() <= 5000
        && data.tips is string
        && data.tips.size() <= 5000
        && data.photosBefore is list
        && data.photosBefore.size() <= 5
        && data.photosDuring is list
        && data.photosDuring.size() <= 5
        && data.photosAfter is list
        && data.photosAfter.size() <= 5
        && data.address.keys().hasAll(['cep', 'street', 'number', 'complement', 'neighborhood', 'city', 'state', 'source'])
        && data.address.keys().hasOnly(['cep', 'street', 'number', 'complement', 'neighborhood', 'city', 'state', 'source'])
        && data.address.cep is string
        && (data.address.cep == '' || data.address.cep.matches('^[0-9]{8}$'))
        && data.address.street is string
        && data.address.street.size() > 0
        && data.address.number is string
        && data.address.number.size() > 0
        && data.address.complement is string
        && data.address.neighborhood is string
        && data.address.city is string
        && data.address.city.size() > 0
        && data.address.state is string
        && isBrazilState(data.address.state)
        && data.address.source in ['cep', 'manual'];
    }

    function validAttendance(data, attendanceId) {
      return data.keys().hasAll(['actionId', 'branchId', 'volunteerId', 'present', 'updatedAt'])
        && data.keys().hasOnly(['actionId', 'branchId', 'volunteerId', 'present', 'updatedAt'])
        && data.actionId is string && data.actionId.size() > 0
        && data.branchId is string && data.branchId.size() > 0
        && data.volunteerId is string && data.volunteerId.size() > 0
        && data.present == true
        && attendanceId == data.actionId + '_' + data.volunteerId;
    }

    function validAttendanceSession(data, actionId) {
      return data.keys().hasAll(['actionId', 'branchId', 'startedAt'])
        && data.keys().hasOnly(['actionId', 'branchId', 'startedAt'])
        && data.actionId == actionId
        && data.branchId is string && data.branchId.size() > 0;
    }

    function regionalCanManageAttendance(actionId, branchId) {
      let action = get(/databases/$(database)/documents/actions/$(actionId)).data;
      return belongsToBranch(branchId)
        && action.branchId == branchId
        && request.time >= action.dateStart
        && request.time < action.dateEnd;
    }

    function validAssociationStats(data) {
      return data.keys().hasAll(['newAssociates', 'updatedAt', 'updatedBy'])
        && data.keys().hasOnly(['newAssociates', 'updatedAt', 'updatedBy'])
        && data.newAssociates is int
        && data.newAssociates >= 0
        && data.newAssociates <= 99999999
        && data.updatedAt is timestamp
        && data.updatedBy == request.auth.uid;
    }

    function validPublicReport(data, year) {
      return data.keys().hasAll(['year', 'path', 'fileName', 'size', 'publishedAt', 'publishedBy'])
        && data.keys().hasOnly(['year', 'path', 'fileName', 'size', 'publishedAt', 'publishedBy'])
        && data.year == year
        && data.year.matches('^[0-9]{4}$')
        && data.path == 'public-reports/' + year + '/report.pdf'
        && data.fileName is string
        && data.fileName.size() > 0
        && data.fileName.size() <= 180
        && data.size is int
        && data.size > 0
        && data.size <= 25 * 1024 * 1024
        && data.publishedAt is timestamp
        && data.publishedBy == request.auth.uid;
    }

    match /branches/{branchId} {
      allow get, list: if isSuperAdmin() || belongsToBranch(branchId);
      allow create, update: if isSuperAdmin() && validBranch(request.resource.data);
      allow delete: if isSuperAdmin();
    }

    match /users/{userId} {
      allow get: if signedIn() && request.auth.uid == userId || isSuperAdmin();

      allow list: if isSuperAdmin();

      // Perfis e seus papéis são criados e atualizados apenas por Functions
      // com Admin SDK. Isso evita perfis privilegiados escritos pelo cliente.
      allow create, update, delete: if false;
    }

    match /volunteers/{volunteerId} {
      allow get: if isSuperAdmin()
        || (isBranchViewer() && resource.data.regionalIds.hasAny([request.auth.token.branchId]))
        || (hasRole('volunteer') && request.auth.uid == volunteerId);

      allow list: if isSuperAdmin()
        || (isBranchViewer() && resource.data.regionalIds.hasAny([request.auth.token.branchId]));

      allow create: if isSuperAdmin() && validVolunteer(request.resource.data);

      allow update: if validVolunteer(request.resource.data)
        && isSuperAdmin();

      allow delete: if isSuperAdmin();
    }

    match /volunteerPrivate/{volunteerId} {
      // CPF, RG e nascimento nunca são expostos pela conta compartilhada da
      // regional. A consulta é restrita ao administrador nacional ou ao próprio
      // voluntário autenticado.
      allow get: if isSuperAdmin()
        || (hasRole('volunteer') && request.auth.uid == volunteerId);

      allow list: if isSuperAdmin();

      allow create: if isSuperAdmin() && validVolunteerPrivate(request.resource.data, volunteerId);

      allow update: if validVolunteerPrivate(request.resource.data, volunteerId)
        && isSuperAdmin();

      allow delete: if isSuperAdmin();
    }

    match /actions/{actionId} {
      allow get: if isSuperAdmin() || belongsToBranch(resource.data.branchId)
        || (hasRole('volunteer') && get(/databases/$(database)/documents/volunteers/$(request.auth.uid)).data.actionIds.hasAny([actionId]));
      allow list: if isSuperAdmin() || belongsToBranch(resource.data.branchId);
      allow create: if isSuperAdmin() && validAction(request.resource.data);
      allow update: if isSuperAdmin()
        && request.resource.data.branchId == resource.data.branchId
        && validAction(request.resource.data);
      allow delete: if isSuperAdmin();
    }

    match /attendance/{attendanceId} {
      allow get: if isSuperAdmin() || belongsToBranch(resource.data.branchId)
        || (hasRole('volunteer') && resource.data.volunteerId == request.auth.uid);
      allow list: if isSuperAdmin() || belongsToBranch(resource.data.branchId);
      allow create: if validAttendance(request.resource.data, attendanceId)
        && (isSuperAdmin() || (regionalCanManageAttendance(request.resource.data.actionId, request.resource.data.branchId)
          && get(/databases/$(database)/documents/volunteers/$(request.resource.data.volunteerId)).data.actionIds.hasAny([request.resource.data.actionId])
          && get(/databases/$(database)/documents/volunteers/$(request.resource.data.volunteerId)).data.regionalIds.hasAny([request.resource.data.branchId])));
      allow update: if validAttendance(request.resource.data, attendanceId)
        && request.resource.data.actionId == resource.data.actionId
        && request.resource.data.branchId == resource.data.branchId
        && request.resource.data.volunteerId == resource.data.volunteerId
        && (isSuperAdmin() || regionalCanManageAttendance(resource.data.actionId, resource.data.branchId));
      allow delete: if isSuperAdmin() || regionalCanManageAttendance(resource.data.actionId, resource.data.branchId);
    }

    match /attendanceSessions/{actionId} {
      allow get: if isSuperAdmin() || belongsToBranch(resource.data.branchId)
        || (hasRole('volunteer') && get(/databases/$(database)/documents/volunteers/$(request.auth.uid)).data.actionIds.hasAny([actionId]));
      allow list: if isSuperAdmin() || belongsToBranch(resource.data.branchId);
      allow create, update: if validAttendanceSession(request.resource.data, actionId)
        && (isSuperAdmin() || regionalCanManageAttendance(actionId, request.resource.data.branchId));
      allow delete: if false;
    }

    match /publicStats/{statId} {
      allow get: if statId == 'associationCampaign';
      allow list: if false;
      allow create, update: if statId == 'associationCampaign'
        && isSuperAdmin()
        && validAssociationStats(request.resource.data);
      allow delete: if false;
    }

    match /publicReports/{year} {
      allow get: if year == '2025';
      allow list: if false;
      allow create, update: if year == '2025'
        && isSuperAdmin()
        && validPublicReport(request.resource.data, year);
      allow delete: if isSuperAdmin();
    }

    // Formulários são acessados exclusivamente por Functions: autenticação,
    // isolamento, validação do snapshot e resposta única em transação.
    match /formAccounts/{document=**} {
      allow read, write: if false;
    }
    match /formTokens/{tokenId} {
      allow read, write: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
