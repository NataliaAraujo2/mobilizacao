rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isActive() {
      return signedIn() && request.auth.token.status == 'active';
    }

    function hasRole(role) {
      return isActive() && request.auth.token.role == role;
    }

    function isSuperAdmin() {
      return hasRole('superAdmin');
    }

    function isBranchViewer() {
      return hasRole('branchViewer');
    }

    function belongsToBranch(branchId) {
      return isActive()
        && request.auth.token.role in ['branchViewer', 'volunteer']
        && request.auth.token.branchId == branchId;
    }

    function isBrazilState(state) {
      return state in ['AC', 'AL', 'AP', 'AM', 'BA', 'CE', 'DF', 'ES', 'GO', 'MA', 'MT', 'MS', 'MG', 'PA', 'PB', 'PR', 'PE', 'PI', 'RJ', 'RN', 'RS', 'RO', 'RR', 'SC', 'SP', 'SE', 'TO'];
    }

    function validBranch(data) {
      return data.keys().hasAll(['name', 'code', 'state', 'status', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['name', 'code', 'state', 'status', 'createdAt', 'updatedAt'])
        && data.name is string
        && data.name.size() >= 2
        && data.name.size() <= 120
        && data.code is string
        && data.code.size() >= 2
        && data.code.size() <= 30
        && data.state is string
        && isBrazilState(data.state)
        && data.status in ['active', 'inactive'];
    }

    function validUser(data) {
      return data.keys().hasAll(['displayName', 'email', 'role', 'branchId', 'status', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['displayName', 'email', 'role', 'branchId', 'contactName', 'contactEmail', 'contactPhone', 'status', 'createdAt', 'updatedAt'])
        && data.displayName is string
        && data.displayName.size() >= 2
        && data.displayName.size() <= 120
        && data.email is string
        && data.email.size() >= 5
        && data.role in ['superAdmin', 'branchViewer', 'volunteer']
        && data.status in ['pending', 'active', 'blocked']
        && (
          (data.role == 'branchViewer'
            && data.keys().hasAll(['contactName', 'contactEmail', 'contactPhone'])
            && data.contactName is string
            && data.contactName.size() >= 2
            && data.contactName.size() <= 120
            && data.contactEmail is string
            && data.contactEmail.size() >= 5
            && data.contactEmail.size() <= 160
            && data.contactPhone is string
            && data.contactPhone.matches('^[0-9]{10,13}$'))
          || (data.role != 'branchViewer' && !data.keys().hasAny(['contactName', 'contactEmail', 'contactPhone']))
        )
        && (
          (data.role == 'superAdmin' && data.branchId == null)
          || (data.role != 'superAdmin' && data.branchId is string && data.branchId.size() > 0)
        );
    }

    function validVolunteer(data) {
      return data.keys().hasAll(['fullName', 'email', 'phone', 'branchId', 'status', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['fullName', 'email', 'phone', 'branchId', 'status', 'createdAt', 'updatedAt'])
        && data.fullName is string
        && data.fullName.size() >= 2
        && data.fullName.size() <= 120
        && data.email is string
        && data.email.size() <= 160
        && data.phone is string
        && data.phone.size() <= 20
        && data.branchId is string
        && data.branchId.size() > 0
        && data.status in ['pending', 'active', 'blocked'];
    }

    function validVolunteerPrivate(data, volunteerId) {
      return data.keys().hasAll(['volunteerId', 'branchId', 'cpf', 'rg', 'birthDate', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['volunteerId', 'branchId', 'cpf', 'rg', 'birthDate', 'createdAt', 'updatedAt'])
        && data.volunteerId == volunteerId
        && data.branchId is string
        && data.branchId.size() > 0
        && data.cpf is string
        && data.cpf.matches('^[0-9]{11}$')
        && data.rg is string
        && data.rg.size() >= 3
        && data.rg.size() <= 20
        && data.birthDate is string
        && data.birthDate.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$');
    }

    function validAction(data) {
      return data.keys().hasAll(['name', 'branchId', 'status', 'address', 'whatToBring', 'tips', 'photosBefore', 'photosDuring', 'photosAfter', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['name', 'branchId', 'status', 'address', 'whatToBring', 'tips', 'photosBefore', 'photosDuring', 'photosAfter', 'createdAt', 'updatedAt'])
        && data.name is string
        && data.name.size() >= 3
        && data.name.size() <= 160
        && data.branchId is string
        && data.branchId.size() > 0
        && data.status in ['planning', 'ongoing', 'completed']
        && data.whatToBring is string
        && data.whatToBring.size() <= 5000
        && data.tips is string
        && data.tips.size() <= 5000
        && data.photosBefore is list
        && data.photosBefore.size() <= 5
        && data.photosDuring is list
        && data.photosDuring.size() <= 5
        && data.photosAfter is list
        && data.photosAfter.size() <= 5
        && data.address.keys().hasAll(['cep', 'street', 'number', 'complement', 'neighborhood', 'city', 'state', 'source'])
        && data.address.keys().hasOnly(['cep', 'street', 'number', 'complement', 'neighborhood', 'city', 'state', 'source'])
        && data.address.cep is string
        && (data.address.cep == '' || data.address.cep.matches('^[0-9]{8}$'))
        && data.address.street is string
        && data.address.street.size() > 0
        && data.address.number is string
        && data.address.number.size() > 0
        && data.address.complement is string
        && data.address.neighborhood is string
        && data.address.city is string
        && data.address.city.size() > 0
        && data.address.state is string
        && isBrazilState(data.address.state)
        && data.address.source in ['cep', 'manual'];
    }

    function validAssociationStats(data) {
      return data.keys().hasAll(['newAssociates', 'updatedAt', 'updatedBy'])
        && data.keys().hasOnly(['newAssociates', 'updatedAt', 'updatedBy'])
        && data.newAssociates is int
        && data.newAssociates >= 0
        && data.newAssociates <= 99999999
        && data.updatedAt is timestamp
        && data.updatedBy == request.auth.uid;
    }

    function validPublicReport(data, year) {
      return data.keys().hasAll(['year', 'path', 'fileName', 'size', 'publishedAt', 'publishedBy'])
        && data.keys().hasOnly(['year', 'path', 'fileName', 'size', 'publishedAt', 'publishedBy'])
        && data.year == year
        && data.year.matches('^[0-9]{4}$')
        && data.path == 'public-reports/' + year + '/report.pdf'
        && data.fileName is string
        && data.fileName.size() > 0
        && data.fileName.size() <= 180
        && data.size is int
        && data.size > 0
        && data.size <= 25 * 1024 * 1024
        && data.publishedAt is timestamp
        && data.publishedBy == request.auth.uid;
    }

    match /branches/{branchId} {
      allow get, list: if isSuperAdmin() || belongsToBranch(branchId);
      allow create, update: if isSuperAdmin() && validBranch(request.resource.data);
      allow delete: if isSuperAdmin();
    }

    match /users/{userId} {
      allow get: if signedIn() && request.auth.uid == userId || isSuperAdmin();

      allow list: if isSuperAdmin();

      // Perfis e seus papéis são criados e atualizados apenas por Functions
      // com Admin SDK. Isso evita perfis privilegiados escritos pelo cliente.
      allow create, update, delete: if false;
    }

    match /volunteers/{volunteerId} {
      allow get: if isSuperAdmin()
        || (isBranchViewer() && resource.data.branchId == request.auth.token.branchId)
        || (hasRole('volunteer') && request.auth.uid == volunteerId);

      allow list: if isSuperAdmin()
        || (isBranchViewer() && resource.data.branchId == request.auth.token.branchId);

      allow create: if isSuperAdmin() && validVolunteer(request.resource.data);

      allow update: if validVolunteer(request.resource.data)
        && request.resource.data.branchId == resource.data.branchId
        && isSuperAdmin();

      allow delete: if isSuperAdmin();
    }

    match /volunteerPrivate/{volunteerId} {
      // CPF, RG e nascimento nunca são expostos pela conta compartilhada da
      // regional. A consulta é restrita ao administrador nacional ou ao próprio
      // voluntário autenticado.
      allow get: if isSuperAdmin()
        || (hasRole('volunteer') && request.auth.uid == volunteerId);

      allow list: if isSuperAdmin();

      allow create: if isSuperAdmin() && validVolunteerPrivate(request.resource.data, volunteerId);

      allow update: if validVolunteerPrivate(request.resource.data, volunteerId)
        && request.resource.data.branchId == resource.data.branchId
        && isSuperAdmin();

      allow delete: if isSuperAdmin();
    }

    match /actions/{actionId} {
      allow get, list: if isSuperAdmin() || belongsToBranch(resource.data.branchId);
      allow create: if isSuperAdmin() && validAction(request.resource.data);
      allow update: if isSuperAdmin()
        && request.resource.data.branchId == resource.data.branchId
        && validAction(request.resource.data);
      allow delete: if isSuperAdmin();
    }

    match /publicStats/{statId} {
      allow get: if statId == 'associationCampaign';
      allow list: if false;
      allow create, update: if statId == 'associationCampaign'
        && isSuperAdmin()
        && validAssociationStats(request.resource.data);
      allow delete: if false;
    }

    match /publicReports/{year} {
      allow get: if year == '2025';
      allow list: if false;
      allow create, update: if year == '2025'
        && isSuperAdmin()
        && validPublicReport(request.resource.data, year);
      allow delete: if isSuperAdmin();
    }

    // Formulários são acessados exclusivamente por Functions: autenticação,
    // isolamento, validação do snapshot e resposta única em transação.
    match /formAccounts/{document=**} {
      allow read, write: if false;
    }
    match /formTokens/{tokenId} {
      allow read, write: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
