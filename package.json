{
  "name": "mobilizacao",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "emulators": "firebase emulators:start --only auth,firestore,storage,functions --project dev",
    "emulators:save": "firebase emulators:start --only auth,firestore,storage,functions --project dev --import=.firebase-emulator-data --export-on-exit=.firebase-emulator-data",
    "seed:superadmin": "node scripts/seedSuperAdmin.mjs",
    "test:rules": "node --test tests/firebase.rules.test.js",
    "test:functions": "node --test functions/viewerIdentity.test.js",
    "test:domain": "node --test functions/viewerIdentity.test.js functions/formDomain.test.js",
    "test:forms:integration": "node --test functions/formsApi.integration.test.js",
    "test:forms:emulated": "firebase emulators:exec --only firestore,storage --project dev \"npm run test:rules && npm run test:forms:integration\"",
    "test:rules:emulated": "firebase emulators:exec --only firestore,storage --project dev \"npm run test:rules\"",
    "build": "vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "deploy:dev": "npm run build && firebase deploy --only hosting --project dev",
    "deploy:prod": "npm run build && firebase deploy --only hosting:principal --project prod"
  },
  "dependencies": {
    "firebase": "^12.2.1",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-router-dom": "^7.18.3"
  },
  "devDependencies": {
    "@eslint/js": "^9.34.0",
    "@firebase/rules-unit-testing": "^5.0.2",
    "@vitejs/plugin-react": "^5.0.2",
    "eslint": "^9.34.0",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "firebase-admin": "^14.3.0",
    "globals": "^16.3.0",
    "vite": "^7.1.3"
  }
}
